# ===== AI Radar configuration =====
# Copy this file to .env and fill in your values.

# --- GitHub (needed) ---
# Personal access token with public_repo (or repo for private repos) scope:
# https://github.com/settings/tokens
GITHUB_TOKEN=
# Leave empty to auto-detect from the token
GITHUB_USER=Sanchit9587

# --- Google Docs (needed) ---
# Path to a Google Cloud service-account JSON key.
# Create: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> Service account -> Keys -> JSON.
# Enable the "Google Docs API" for the project, then SHARE both Google Docs
# with the service account's email (xxx@yyy.iam.gserviceaccount.com) as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
NEWS_DOC_ID=1E_cJ53dGq1a1AQ4YEBhLzbDtcGFwZwTwVHYfzxCyguA
TRACKER_DOC_ID=1NEyBKO0ig9Jx-M28scfEZHAkmsj0Uryv2LrGNk6A848

# --- Email (needed) ---
# Gmail SMTP with an App Password (2FA must be on):
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
EMAIL_ADDRESS=sanchit9587@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=sanchit9587@gmail.com

# --- LLM analysis (optional but recommended) ---
# Any OpenAI-compatible endpoint. Default: Gemini via its OpenAI-compatible API.
# Key from aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# --- Behaviour ---
TIMEZONE=Asia/Kolkata
STATE_FILE=state/state.json
